# my.telegram.org se milega (Bot ke liye)
API_ID=1234567
API_HASH=your_api_hash_here

# @BotFather se bot bana ke token le lo
BOT_TOKEN=your_bot_token_here

# Assistant account (userbot) ka session string - VC join karne ke liye zaroori hai
# generate_session.py chala ke ye milega
SESSION_STRING=your_pyrogram_session_string_here

# Comma separated list of user_ids jo bot admin honge (optional)
SUDO_USERS=123456789,987654321
